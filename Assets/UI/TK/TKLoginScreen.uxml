<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" editor-extension-namespace="UnityEditor" noNamespaceSchemaLocation="../../UIElementsSchema/UnityEngine.UIElements.xsd">

    <ui:VisualElement name="MainContainer" style="flex-grow: 1; align-items: center; justify-content: center; background-color: #F0FFF0;">
        
        <ui:Label name="global-status-label" text="" style="height: 30px; color: #00A38D;"/>

        <ui:VisualElement name="LoginPanelRoot" class="panel-root" style="width: 80%; max-width: 400px; padding: 30px; background-color: #FFFFFF; border-radius: 10px; border-width: 1px; border-color: #E0E0E0; margin-bottom: 20px; -unity-text-align: middle-center;">
            
            <ui:Label text="Đăng nhập" name="login-title" style="font-size: 28px; font-weight: bold; color: #333333; margin-bottom: 30px; -unity-text-align: middle-center;"/>
            
            <ui:Label text="Email" style="color: #333333; font-size: 14px; margin-bottom: 5px;"/>
            <ui:TextField value="Nhập email của bạn" name="login-email-input" class="elegant-input" style="height: 40px; margin-bottom: 20px;"/>
            
            <ui:Label text="Mật khẩu" style="color: #333333; font-size: 14px; margin-bottom: 5px;"/>
            <ui:TextField value="Nhập mật khẩu" name="login-password-input" is-password="true" class="elegant-input" style="height: 40px; margin-bottom: 30px;"/>

            <ui:Button text="ĐĂNG NHẬP" name="login-button" style="height: 45px; margin-bottom: 15px; background-color: #00A38D; color: #FFFFFF; font-size: 16px; border-radius: 5px; border-width: 0;"/>
            
            <ui:Button text="Quên mật khẩu?" name="forgot-password-button" style="background-color: transparent; border-width: 0; color: #00A38D; -unity-text-align: middle-center; margin-bottom: 30px;"/>
            
            <ui:Button text="Chuyển sang ĐĂNG KÝ" name="show-create-account-button" style="background-color: #FFFFFF; color: #00A38D; height: 45px; border-color: #00A38D; border-width: 1px; border-radius: 5px; font-size: 16px;"/>
        </ui:VisualElement>

        <ui:VisualElement name="CreateAccountPanelRoot" class="panel-root" style="width: 80%; max-width: 400px; padding: 30px; background-color: #FFFFFF; border-radius: 10px; border-width: 1px; border-color: #E0E0E0; display: none;">
            <ui:Label text="Tạo tài khoản" name="signup-title" style="font-size: 28px; font-weight: bold; color: #333333; margin-bottom: 30px; -unity-text-align: middle-center;"/>
            
            <ui:Label text="Tên tài khoản" style="color: #333333; font-size: 14px; margin-bottom: 5px;"/>
            <ui:TextField name="signup-username-input" class="elegant-input" style="height: 40px; margin-bottom: 15px;"/>
            
            <ui:Label text="Email" style="color: #333333; font-size: 14px; margin-bottom: 5px;"/>
            <ui:TextField name="signup-email-input" class="elegant-input" style="height: 40px; margin-bottom: 15px;"/>
            
            <ui:Label text="Mật khẩu" style="color: #333333; font-size: 14px; margin-bottom: 5px;"/>
            <ui:TextField name="signup-password-input" is-password="true" class="elegant-input" style="height: 40px; margin-bottom: 15px;"/>
            
            <ui:Label text="Xác nhận mật khẩu" style="color: #333333; font-size: 14px; margin-bottom: 5px;"/>
            <ui:TextField name="signup-confirm-password-input" is-password="true" class="elegant-input" style="height: 40px; margin-bottom: 30px;"/>


            <ui:Button text="TẠO TÀI KHOẢN" name="create-account-button" style="height: 45px; margin-bottom: 15px; background-color: #00A38D; color: #FFFFFF; font-size: 16px; border-radius: 5px; border-width: 0;"/>
            
            <ui:Button text="Chuyển sang ĐĂNG NHẬP" name="show-login-button" style="background-color: #FFFFFF; color: #00A38D; height: 45px; border-color: #00A38D; border-width: 1px; border-radius: 5px; font-size: 16px;"/>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
