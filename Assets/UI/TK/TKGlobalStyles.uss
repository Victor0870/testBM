/* File: Assets/UI/TK/TKGlobalStyles.uss */

/* Quy tắc này áp dụng cho mọi VisualElement trong UI */
* {
    /* * Kéo một trong các tệp Font Inter SDF (ví dụ: Inter_24pt-Regular SDF)
     * vào trường font của quy tắc CSS này trong Inspector
     * (hoặc nhập đường dẫn GUID nếu chỉnh sửa bằng VS Code)
     */
    -unity-font-definition: resource("Assets/Fonts/Inter/Inter_24pt-Regular SDF.asset"); /* Ví dụ về đường dẫn */
    /* Hoặc chỉ định font size cơ bản nếu cần */
    font-size: 14px;
    color: white; /* Đảm bảo màu chữ hiển thị tốt trên nền tối */
}

/* Tùy chọn: Đảm bảo các TextField cũng dùng font này */
.unity-base-text-field__input {
    -unity-font-definition: resource("Assets/Fonts/Inter/Inter_24pt-Regular SDF.asset");
}